generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  nick      String   @unique
  score     Int      @default(0)
  badges    String[]
  level     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}