generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  nick      String   @unique
  score     Int      @default(0)
  badges    String[]
  level     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}